# Ironflow Kubernetes Cluster — Terraform Variables
#
# Pre-built configurations are available per deployment template:
#   terraform.small.tfvars   — 1 control + 1 worker
#   terraform.medium.tfvars  — 3 control + 1 worker
#   terraform.large.tfvars   — 3 control + 2 workers
#
# Usage:
#   terraform apply -var-file=terraform.small.tfvars
#   Or copy one to terraform.tfvars and customize:
#   cp terraform.small.tfvars terraform.tfvars
#
# Do NOT commit terraform.tfvars (it's in .gitignore).

# Required: Hetzner Cloud API token
# Set here, or use HCLOUD_TOKEN env var (the CLI passes it to Terraform automatically).
# hcloud_token = "your-token-here"

# Optional: override defaults (defaults match the Large cluster)
# cluster_name        = "ironflow"
# location            = "fsn1"      # fsn1 (Falkenstein), nbg1 (Nuremberg), hel1 (Helsinki)
# control_plane_type  = "cpx22"     # 3 vCPU, 4GB RAM
# control_plane_count = 3
# worker_type         = "cpx32"     # 4 vCPU, 8GB RAM
# worker_count        = 2
