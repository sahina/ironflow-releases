# deploy/docker-compose/cluster/.env.example
# Template for .env. Run ./init-env.sh: it copies this file to .env and fills
# the required values below with random ones. Then, e.g.
#   docker compose -f docker-compose.starter.yml up -d   (Starter: 1 node, 1 NATS)
#   docker compose -f docker-compose.cluster.yml up -d   (Cluster: 3 nodes, 3-node NATS quorum)
#   docker compose -f docker-compose.ha.yml up -d        (HA: Cluster + 5 NATS + PostgreSQL failover)
# The starter, cluster and ha files refuse to start while a required value is empty.

# ─── Ironflow image ──────────────────────────────────────────────────────────

# Container image for the ironflow nodes. In the published bundle each compose
# file already defaults to the release it came with; set this only to run
# another version. In the engine repo the default is `ironflow:latest`, which
# `make docker-build` builds locally.
# IRONFLOW_IMAGE=ghcr.io/sahina/ironflow-releases:<version>

# ─── PostgreSQL ──────────────────────────────────────────────────────────────

# Password for the PostgreSQL `ironflow` user. Required.
# The username (ironflow) and database name (ironflow) are fixed in the compose files.
# Starter and Cluster: Postgres stores it at first start; changing it later does
# not change the database. HA: pg-init sets it on every start.
POSTGRES_PASSWORD=

# HA only: the PostgreSQL superuser (postgres) and replication (standby)
# passwords for the Spilo/Patroni nodes. Required by docker-compose.ha.yml.
# Applied when the cluster is first created: do not change them afterwards.
POSTGRES_SUPERUSER_PASSWORD=
POSTGRES_REPLICATION_PASSWORD=

# HA only: the PostgreSQL major and the Spilo image. Like POSTGRES_IMAGE,
# they are your data volumes' pin after the first start; a bundle update
# replaces the compose files but not this file. Move them only with a dump
# and restore into fresh volumes.
PGVERSION=18
SPILO_IMAGE=ghcr.io/zalando/spilo-18:4.1-p2

# Container image for PostgreSQL. This is the major a new install starts on;
# after the first `up` it is your data volume's pin, and a newer major refuses
# to boot against a volume an older one initdb'd. A pull of this bundle replaces
# the compose files but not your .env, so it stays where you set it — unless you
# export POSTGRES_IMAGE, which wins over .env.
# The starter, cluster and multi-node files read this one variable, so moving it
# moves all three. HA runs Spilo instead: see PGVERSION and SPILO_IMAGE.
# Dump, drop the volume, restore: docs/reference/cli/commands/deploy.md.
POSTGRES_IMAGE=postgres:16-alpine

# ─── Secrets Encryption ──────────────────────────────────────────────────────

# AES-256 master key for encrypting secrets at rest (hex-encoded 32 bytes). Required.
# Keep a copy: without this key, stored secrets cannot be read.
# Generate with: openssl rand -hex 32
IRONFLOW_MASTER_KEY=

# Dashboard login signing key (hex-encoded 32 bytes). Required. Every node uses
# it, so a login made on one node works on the others.
# Generate with: openssl rand -hex 32
IRONFLOW_JWT_SECRET=

# ─── S3 blob storage (SeaweedFS) ─────────────────────────────────────────────

# Access key pair for the bundled SeaweedFS S3 service. Required. Ironflow and
# SeaweedFS both read them from here.
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ─── First admin ─────────────────────────────────────────────────────────────

# Admin API key stored at first boot (ifkey_ + 32 hex). Optional: when empty,
# the server writes a generated key to a file inside the container instead.
# Generate with: echo "ifkey_$(openssl rand -hex 16)"
IRONFLOW_BOOTSTRAP_ADMIN_KEY=

# Dashboard password for admin@ironflow.local, stored at first boot (72 bytes
# or less, no spaces at the ends). Needs IRONFLOW_BOOTSTRAP_ADMIN_KEY. Changing
# it later changes nothing; change the password in the dashboard instead.
IRONFLOW_BOOTSTRAP_ADMIN_PASSWORD=

# ─── Cluster Tuning (optional) ───────────────────────────────────────────────

# How long a scheduler claim can be held before another node reclaims it.
# Increase if you have long-running or slow scheduler operations.
# Default: 2m  Format: Go duration string (e.g. "5m", "30s")
# IRONFLOW_STALE_CLAIM_THRESHOLD=2m

# ─── NATS Authentication (optional) ─────────────────────────────────────────

# Path to a NATS credentials file (.creds) for JWT/NKey authentication.
# Required only when your external NATS server enforces authentication.
# IMPORTANT: The path must be a path *inside the container*.
#   1. Add a volume mount to the ironflow services in the cluster compose file
#      (docker-compose.starter.yml or docker-compose.cluster.yml):
#        volumes:
#          - /host/path/to/nats.creds:/etc/ironflow/nats.creds:ro
#   2. Set this var to the container-side path:
#        NATS_CREDS_FILE=/etc/ironflow/nats.creds
#
# Generate credentials with the nsc CLI:
#   nsc add user --account <MyAccount> --name ironflow-node
#   nsc generate creds --account <MyAccount> --name ironflow-node > /etc/ironflow/nats.creds
# See: https://docs.nats.io/using-nats/nats-tools/nsc
# NATS_CREDS_FILE=

# ─── Observability (monitoring profile) ──────────────────────────────────────
#
# These only take effect under: docker compose -f <file> --profile monitoring up
# which adds Prometheus (:9090), Jaeger (:16686), and Grafana (:3000).
# See docs/how-to-guides/observability.mdx for metrics and example queries.

# Expose the Prometheus /metrics endpoint on each node's API port. On by default
# so Prometheus can scrape without extra config. Set false to disable metrics.
# IRONFLOW_METRICS_ENABLED=true

# OTLP gRPC endpoint for trace export. Defaults to the bundled jaeger service.
# Without --profile monitoring that host is absent, so nodes log harmless
# connection retries — set this empty to disable tracing entirely.
# IRONFLOW_OTEL_ENDPOINT=jaeger:4317
# IRONFLOW_OTEL_SAMPLE_RATE=1.0
# IRONFLOW_OTEL_SERVICE_NAME=ironflow

# Grafana admin login (edit access). Anonymous users get read-only Viewer access
# without logging in. Change the password before exposing the stack off localhost.
# GRAFANA_ADMIN_USER=admin
# GRAFANA_ADMIN_PASSWORD=admin
