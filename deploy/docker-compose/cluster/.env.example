# deploy/docker-compose/cluster/.env.example
# Copy to .env and fill in values before running the cluster compose, e.g.
#   docker compose -f docker-compose.multi-node.yml up      (single NATS)
#   docker compose -f docker-compose.cluster.yml up          (3-node NATS quorum)

# ─── Ironflow image ──────────────────────────────────────────────────────────

# Container image for the ironflow nodes. Leave unset for local development —
# it defaults to `ironflow:latest`, which `make test-cluster-e2e` builds locally.
# Public users running the downloaded bundle should uncomment the line below to
# pull the released image (no source build required):
# IRONFLOW_IMAGE=ghcr.io/sahina/ironflow-releases:latest

# ─── PostgreSQL ──────────────────────────────────────────────────────────────

# Password for the PostgreSQL `ironflow` user.
# The username (ironflow) and database name (ironflow) are fixed in the compose files.
# Use a strong random password for any non-local environment.
# Generate with: openssl rand -base64 24
POSTGRES_PASSWORD=ironflow

# ─── Secrets Encryption ──────────────────────────────────────────────────────

# AES-256 master key for encrypting secrets at rest (hex-encoded 32 bytes).
# If not set, secrets are stored unencrypted — acceptable for local dev only.
# Generate with: openssl rand -hex 32
# IRONFLOW_MASTER_KEY=

# ─── Cluster Tuning (optional) ───────────────────────────────────────────────

# How long a scheduler claim can be held before another node reclaims it.
# Increase if you have long-running or slow scheduler operations.
# Default: 2m  Format: Go duration string (e.g. "5m", "30s")
# IRONFLOW_STALE_CLAIM_THRESHOLD=2m

# ─── NATS Authentication (optional) ─────────────────────────────────────────

# Path to a NATS credentials file (.creds) for JWT/NKey authentication.
# Required only when your external NATS server enforces authentication.
# IMPORTANT: The path must be a path *inside the container*.
#   1. Add a volume mount to the ironflow services in the cluster compose file
#      (docker-compose.multi-node.yml or docker-compose.cluster.yml):
#        volumes:
#          - /host/path/to/nats.creds:/etc/ironflow/nats.creds:ro
#   2. Set this var to the container-side path:
#        NATS_CREDS_FILE=/etc/ironflow/nats.creds
#
# Generate credentials with the nsc CLI:
#   nsc add user --account <MyAccount> --name ironflow-node
#   nsc generate creds --account <MyAccount> --name ironflow-node > /etc/ironflow/nats.creds
# See: https://docs.nats.io/using-nats/nats-tools/nsc
# NATS_CREDS_FILE=

# ─── Observability (monitoring profile) ──────────────────────────────────────
#
# These only take effect under: docker compose -f <file> --profile monitoring up
# which adds Prometheus (:9090), Jaeger (:16686), and Grafana (:3000).
# See docs/how-to-guides/observability.mdx for metrics and example queries.

# Expose the Prometheus /metrics endpoint on each node's API port. On by default
# so Prometheus can scrape without extra config. Set false to disable metrics.
# IRONFLOW_METRICS_ENABLED=true

# OTLP gRPC endpoint for trace export. Defaults to the bundled jaeger service.
# Without --profile monitoring that host is absent, so nodes log harmless
# connection retries — set this empty to disable tracing entirely.
# IRONFLOW_OTEL_ENDPOINT=jaeger:4317
# IRONFLOW_OTEL_SAMPLE_RATE=1.0
# IRONFLOW_OTEL_SERVICE_NAME=ironflow

# Grafana admin login (edit access). Anonymous users get read-only Viewer access
# without logging in. Change the password before exposing the stack off localhost.
# GRAFANA_ADMIN_USER=admin
# GRAFANA_ADMIN_PASSWORD=admin
