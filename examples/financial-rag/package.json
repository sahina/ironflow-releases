{
  "name": "ironflow-financial-rag",
  "private": true,
  "type": "module",
  "scripts": {
    "seed-corpus": "tsx scripts/seed-corpus.ts",
    "poll": "tsx --env-file-if-exists=.env scripts/trigger-poll.ts",
    "setup": "tsx --env-file-if-exists=.env setup.ts",
    "start": "tsx --env-file-if-exists=.env worker.ts",
    "dev": "tsx watch --env-file-if-exists=.env worker.ts",
    "ask": "tsx --env-file-if-exists=.env cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "@ironflow/node": "workspace:*",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/pg": "^8.21.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
