# Ironflow's own database — Ironflow owns it. The app never connects here.
IRONFLOW_DATABASE_URL=postgres://ironflow:ironflow@localhost:5434/ironflow
IRONFLOW_URL=http://localhost:9123

# The app's database — chunks, embeddings, index pointer. pgvector lives here.
RAGAPP_DATABASE_URL=postgres://ironflow:ironflow@localhost:5434/ragapp

ANTHROPIC_API_KEY=sk-ant-...
VOYAGE_API_KEY=pa-...

# Where the source filings live. Populate with `pnpm seed-corpus`.
SOURCE_DIR=./corpus

# The golden set the eval scores against.
# GOLDEN_PATH=./evals/golden.yaml
