{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ironflow.run/reference-app/contracts/approve.order.v1.schema.json",
  "title": "approve.order command (v1)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "data",
    "metadata"
  ],
  "properties": {
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "orderId",
        "approvedBy"
      ],
      "properties": {
        "orderId": {
          "$ref": "https://ironflow.run/reference-app/contracts/common.v1.schema.json#/$defs/entityId"
        },
        "approvedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        }
      }
    },
    "metadata": {
      "$ref": "https://ironflow.run/reference-app/contracts/metadata.v1.schema.json"
    }
  }
}
