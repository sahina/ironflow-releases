{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ironflow.run/reference-app/contracts/order.placed.v1.schema.json",
  "title": "order.placed fact (v1)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "data",
    "metadata"
  ],
  "properties": {
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "orderId",
        "customerEmail",
        "items",
        "totalCents",
        "currency",
        "paymentMethodToken",
        "placedAt"
      ],
      "properties": {
        "orderId": {
          "$ref": "https://ironflow.run/reference-app/contracts/common.v1.schema.json#/$defs/entityId"
        },
        "customerEmail": {
          "$ref": "https://ironflow.run/reference-app/contracts/common.v1.schema.json#/$defs/email"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sku",
              "quantity",
              "unitPriceCents",
              "lineTotalCents"
            ],
            "properties": {
              "sku": {
                "$ref": "https://ironflow.run/reference-app/contracts/common.v1.schema.json#/$defs/sku"
              },
              "quantity": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10
              },
              "unitPriceCents": {
                "$ref": "https://ironflow.run/reference-app/contracts/common.v1.schema.json#/$defs/amountCents"
              },
              "lineTotalCents": {
                "$ref": "https://ironflow.run/reference-app/contracts/common.v1.schema.json#/$defs/amountCents"
              }
            }
          }
        },
        "totalCents": {
          "$ref": "https://ironflow.run/reference-app/contracts/common.v1.schema.json#/$defs/amountCents"
        },
        "currency": {
          "$ref": "https://ironflow.run/reference-app/contracts/common.v1.schema.json#/$defs/currency"
        },
        "paymentMethodToken": {
          "$ref": "https://ironflow.run/reference-app/contracts/common.v1.schema.json#/$defs/paymentMethodToken"
        },
        "placedAt": {
          "$ref": "https://ironflow.run/reference-app/contracts/common.v1.schema.json#/$defs/timestamp"
        }
      }
    },
    "metadata": {
      "$ref": "https://ironflow.run/reference-app/contracts/metadata.v1.schema.json"
    }
  }
}
