# Optional. Without keys the example still runs end to end:
# embeddings fall back to a deterministic offline stand-in (retrieval quality
# is meaningless) and `ask` prints the retrieved context instead of an answer.
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
IRONFLOW_URL=http://localhost:9123

# REQUIRED. The server refuses unauthenticated function registration and emits
# with a bare 401. On first `ironflow serve` the bootstrap key is written to
# .ironflow/.ironflow_bootstrap_key.json next to the binary:
#   cat .ironflow/.ironflow_bootstrap_key.json | jq -r .key
IRONFLOW_API_KEY=
